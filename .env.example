# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/term_checker

# API
PORT=3000
NODE_ENV=development

# Admin
ADMIN_SECRET=change-me-to-a-random-32-char-secret

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Background worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_STALE_JOB_TIMEOUT_MS=600000
