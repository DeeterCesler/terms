{
  "manifest_version": 3,
  "name": "Term Checker",
  "version": "1.0.0",
  "description": "Instantly see how a website handles your data — privacy score, key findings, and plain-English summary.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://terms-vzh0.onrender.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Term Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
